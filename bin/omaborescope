#!/usr/bin/env bash
# Watch a General Tools iBorescope4 (DCiS4 / iSNAKESCOPE) from an Omarchy PC.
# The scope is its own Wi-Fi access point. This joins that network without
# taking the default route, then plays the camera's Motion-JPEG stream.
set -euo pipefail

SSID="iSNAKESCOPE"
HOST="192.168.1.1"
CON="omaborescope"
# Factory password printed in the DCiS4 quick start. Override it if the
# scope's Wi-Fi password was changed.
PASS="${OMABORESCOPE_WIFI_PSK:-12345678}"
ANDROID_URL="https://github.com/lukejmorrison/omaborescope/releases/latest/download/wizwam-borescope.apk"
STREAM_URL="http://${HOST}/videostream.cgi?user=admin&pwd=&stream=1"
SNAP_URL="http://${HOST}/snapshot.cgi?user=admin&pwd="

state="${XDG_STATE_HOME:-$HOME/.local/state}/omaborescope"
pictures="${XDG_PICTURES_DIR:-$HOME/Pictures}/OmaBorescope"
movies="${XDG_VIDEOS_DIR:-$HOME/Videos}/OmaBorescope"
mkdir -p "$state" "$pictures" "$movies"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

wifi_iface() {
  nmcli -t -f DEVICE,TYPE device status | awk -F: '$2 == "wifi" && $1 != "" { print $1; exit }'
}

active_on_iface() {
  local iface="$1"
  nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v i="$iface" '$2 == i { print $1; exit }'
}

camera_up() {
  curl -fsS -m 2 -o /dev/null "$SNAP_URL" 2>/dev/null
}

wait_camera() {
  local i
  for i in $(seq 1 30); do
    if camera_up; then
      return 0
    fi
    sleep 0.5
  done
  die "Joined iSNAKESCOPE, but the camera did not answer. Click the thumbwheel, wait for the slow green flash, and try again."
}

ensure_camera() {
  if camera_up; then
    return 0
  fi
  command -v nmcli >/dev/null || die "NetworkManager is required to join iSNAKESCOPE."
  local iface prev
  iface="$(wifi_iface)"
  [[ -n "$iface" ]] || die "No Wi-Fi device found."
  prev="$(active_on_iface "$iface" || true)"
  if [[ -n "$prev" && "$prev" != "$CON" ]]; then
    printf '%s\n' "$prev" >"$state/previous-wifi"
  fi
  if nmcli -t -f NAME connection show | grep -qx "$CON"; then
    nmcli connection modify "$CON" \
      connection.interface-name "$iface" \
      802-11-wireless.ssid "$SSID" \
      802-11-wireless-security.key-mgmt wpa-psk \
      802-11-wireless-security.psk "$PASS" \
      ipv4.method auto \
      ipv4.never-default yes \
      ipv6.method ignore \
      connection.autoconnect no
  else
    nmcli connection add type wifi \
      con-name "$CON" ifname "$iface" ssid "$SSID" \
      wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PASS" \
      ipv4.method auto ipv4.never-default yes \
      ipv6.method ignore connection.autoconnect no >/dev/null
  fi
  nmcli connection up "$CON" >/dev/null
  wait_camera
}

pid_alive() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

stop_pid() {
  local file="$1"
  local sig="${2:-TERM}"
  pid_alive "$file" || { rm -f "$file"; return 0; }
  local pid
  pid="$(cat "$file")"
  kill "-$sig" "$pid" 2>/dev/null || true
  local i
  for i in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$file"
}

recording() {
  pid_alive "$state/record.pid"
}

cmd_status() {
  if camera_up; then
    echo "scope=ready"
  else
    echo "scope=off"
  fi
  if recording; then
    echo "recording=yes"
  else
    echo "recording=no"
  fi
}

cmd_watch() {
  command -v ffplay >/dev/null || die "ffplay is not installed. It ships with ffmpeg."
  ensure_camera
  if pid_alive "$state/watch.pid"; then
    echo "watching=yes"
    return 0
  fi
  setsid ffplay \
    -window_title OmaBorescope \
    -fflags nobuffer -flags low_delay -framedrop \
    -probesize 32 -analyzeduration 0 \
    "$STREAM_URL" >/dev/null 2>&1 &
  echo $! >"$state/watch.pid"
  echo "watching=yes"
}

cmd_snap() {
  ensure_camera
  local dest sig
  dest="$pictures/$(date +%Y%m%d-%H%M%S).jpg"
  curl -fsS -m 8 -o "$dest" "$SNAP_URL"
  sig="$(od -An -t x1 -N 2 "$dest" | tr -d ' \n')"
  [[ "$sig" == "ffd8" ]] || { rm -f "$dest"; die "The camera did not return a photo."; }
  command -v notify-send >/dev/null && notify-send "OmaBorescope" "Photo saved" || true
  echo "saved=$dest"
}

cmd_record() {
  command -v ffmpeg >/dev/null || die "ffmpeg is not installed."
  if recording; then
    echo "recording=yes"
    return 0
  fi
  ensure_camera
  local dest
  dest="$movies/$(date +%Y%m%d-%H%M%S).mp4"
  setsid ffmpeg -y -nostdin \
    -fflags nobuffer -flags low_delay \
    -i "$STREAM_URL" -an \
    -c:v libx264 -pix_fmt yuv420p -preset veryfast \
    "$dest" >"$state/record.log" 2>&1 &
  echo $! >"$state/record.pid"
  printf '%s\n' "$dest" >"$state/record.path"
  echo "recording=yes"
}

cmd_stop() {
  local saved=""
  if [[ -f "$state/record.path" ]]; then
    saved="$(cat "$state/record.path")"
  fi
  stop_pid "$state/record.pid" INT
  stop_pid "$state/watch.pid" TERM
  if [[ -n "$saved" && -f "$saved" ]]; then
    echo "saved=$saved"
  else
    echo "stopped=yes"
  fi
}

cmd_leave() {
  cmd_stop >/dev/null || true
  nmcli connection down "$CON" >/dev/null 2>&1 || true
  if [[ -f "$state/previous-wifi" ]]; then
    nmcli connection up "$(cat "$state/previous-wifi")" >/dev/null 2>&1 || true
  fi
  echo "left=yes"
}

cmd_android() {
  command -v xdg-open >/dev/null || die "xdg-open is not installed."
  xdg-open "$ANDROID_URL" >/dev/null 2>&1 || die "Could not open the Android download."
  echo "opened=$ANDROID_URL"
}

usage() {
  cat <<EOF
Usage: omaborescope <watch|snap|record|stop|leave|android|status>

  watch     Join iSNAKESCOPE and open the live picture
  snap      Save a still into Pictures/OmaBorescope
  record    Save a clip into Videos/OmaBorescope
  stop      Stop the live window and the recording
  leave     Stop, then drop the scope Wi-Fi
  android   Open the Android app download
  status    Print scope=ready|off and recording=yes|no
EOF
}

case "${1:-}" in
  watch) cmd_watch ;;
  snap) cmd_snap ;;
  record) cmd_record ;;
  stop) cmd_stop ;;
  leave) cmd_leave ;;
  android) cmd_android ;;
  status) cmd_status ;;
  -h|--help|help|"") usage ;;
  *) die "Unknown command: $1" ;;
esac
